branch="$(git branch --show-current)"

case "$branch" in
  main|develop)
    exit 0
    ;;
esac

if ! printf '%s\n' "$branch" | grep -Eq '^(feature|fix)/[a-z]+(-[a-z]+)*/[0-9]+$'; then
  echo "Invalid branch name: $branch"
  echo "Expected format: <type>/<branch-description>/<number>"
  echo "Allowed types: feature, fix"
  echo "Examples:"
  echo "  feature/add-login-form/00"
  echo "  fix/handle-empty-response/12"
  exit 1
fi

subject=$(sed -n '1p' "$1")
prefix="$branch: "

case "$subject" in
  "$prefix"*)
    summary=${subject#"$prefix"}
    ;;
  *)
    echo "Invalid commit subject: $subject"
    echo "Expected format: $branch: <description>"
    echo "Example: $branch: add pre-commit hook"
    exit 1
    ;;
esac

if [ -z "$(printf '%s' "$summary" | tr -d '[:space:]')" ]; then
  echo "Commit description must not be empty."
  echo "Expected format: $branch: <description>"
  exit 1
fi